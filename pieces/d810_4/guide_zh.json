  "glossary": [
   {
    "term": "主调织体",
    "explanation": "几件乐器节奏大体一致，像一起唱和弦。"
   },
   {
    "term": "齐奏",
    "explanation": "几件乐器用相同的音（或相差八度）演奏同一条旋律。"
   },
   {
    "term": "渐强 / 渐弱",
    "explanation": "声音慢慢变响 / 慢慢变轻。"
   },
   {
    "term": "转调",
    "explanation": "音乐的“中心调”改变，色彩随之变亮或变暗。大调通常偏明亮，小调偏暗。"
   },
   {
    "term": "pp / p / f / ff / fff",
    "explanation": "很弱 / 弱 / 强 / 很强 / 最强。"
   },
   {
    "term": "Prestissimo",
    "explanation": "意为“比急板还快”，这里是乐章最后的尾声。"
   }
  ]
