  "glossary": [
   {
    "term": "转调",
    "explanation": "音乐的“中心音”改变，色彩随之变亮或变暗。"
   },
   {
    "term": "小调/大调",
    "explanation": "小调听起来偏暗、忧伤，大调偏明亮。"
   },
   {
    "term": "主调织体",
    "explanation": "几个声部节奏基本一致，一起走和弦。"
   },
   {
    "term": "pp / ppp",
    "explanation": "很弱 / 极弱。f 为强，ff 为很强。"
   },
   {
    "term": "a tempo",
    "explanation": "乐谱用语，意思是回到原来的速度。"
