  "glossary": [
   {
    "term": "主旋律",
    "explanation": "乐章开头出现的那条易记的曲调，之后会在不同声部和不同高度回来。"
   },
   {
    "term": "齐奏/八度",
    "explanation": "各声部唱同一条线，只是有的高八度、有的低八度。"
   },
   {
    "term": "旋律加伴奏",
    "explanation": "一个声部唱旋律，其他声部在下面伴奏。"
   },
   {
    "term": "主调织体",
    "explanation": "旋律在上，其他声部以和弦相伴，各声部节奏大体一致。"
   },
   {
    "term": "独立线条",
    "explanation": "各声部各唱各的旋律线，互不相同。"
   },
   {
    "term": "渐强/渐弱",
    "explanation": "声音逐渐变响或逐渐变轻。乐谱上有标记才算渐变，否则是突然变化。"
   },
   {
    "term": "fz/fp",
    "explanation": "重音记号。fz是突然加重一下，fp是先强后立刻转弱。"
   },
   {
    "term": "a tempo",
    "explanation": "回到原来的速度。"
   },
   {
    "term": "大调/小调",
    "explanation": "大调听起来较明亮，小调听起来较暗淡。本指南中的调性是软件估算的。"
   }
  ]
 },
