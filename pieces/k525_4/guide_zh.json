  "glossary": [
   {
    "term": "回旋曲",
    "explanation": "一种曲式:开头的主旋律反复回来,中间夹着不同的段落。"
   },
   {
    "term": "主旋律(主题)",
    "explanation": "乐曲中最主要、最容易记住的旋律。"
   },
   {
    "term": "转调",
    "explanation": "音乐从一个调换到另一个调。听起来像换了一种明暗或亮度。"
   },
   {
    "term": "大调/小调",
    "explanation": "大调听起来明亮,小调听起来较暗、较忧郁。"
   },
   {
    "term": "p / mf / f",
    "explanation": "力度记号:p是弱,mf是中强,f是强。"
   },
   {
    "term": "齐奏(八度)",
    "explanation": "几个声部同时奏同一条旋律,声音集中有力。"
   },
   {
    "term": "旋律加伴奏",
    "explanation": "一个声部奏旋律,其他声部在下面伴奏。"
   },
   {
    "term": "主调织体(homophonic)",
    "explanation": "各声部节奏大致相同,像一起合唱。"
   },
   {
    "term": "三声部织体(trio)",
    "explanation": "四件乐器中只有三件在演奏,一件休止,声音比较通透。"
   }
  ]
 },
