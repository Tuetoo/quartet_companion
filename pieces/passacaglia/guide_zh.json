  "glossary": [
   {
    "term": "帕萨卡利亚",
    "explanation": "一种变奏曲:一段短主题之后跟着许多变奏,每段长度相同,但内容不断改写。"
   },
   {
    "term": "变奏",
    "explanation": "把同一段音乐换一种写法再奏一遍,比如更快、更轻或换声部。"
   },
   {
    "term": "主调织体(homophonic)",
    "explanation": "两个声部节奏大体一致,听起来像在一起唱和弦。"
   },
   {
    "term": "转调",
    "explanation": "音乐的“中心音”改变。从小调到大调常常听起来更明亮。"
   },
   {
    "term": "渐强/渐弱",
    "explanation": "声音逐渐变响或逐渐变轻。"
   },
   {
    "term": "tacet(停奏)",
    "explanation": "某个声部在一段时间内完全不演奏。"
   }
  ]
